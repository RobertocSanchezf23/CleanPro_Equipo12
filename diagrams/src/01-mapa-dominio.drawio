        <mxCell id="b44" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Entity (referencia)»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Cuadrilla&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Id : CuadrillaId&lt;br/&gt;+ Nombre : string&lt;br/&gt;+ Integrantes : List&amp;lt;IntegranteId&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g43" vertex="1">
