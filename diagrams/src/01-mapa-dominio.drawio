        <mxCell id="b24" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«enumeration»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;TipoDeIncidencia&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;ServicioAdicionalEnSitio&lt;br/&gt;MaterialEspecial&lt;br/&gt;InmuebleMayorALoReportado&lt;br/&gt;ClienteNoPermiteAcceso&lt;br/&gt;EmpleadoAusente&lt;br/&gt;OtroCambio&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g18" vertex="1">
