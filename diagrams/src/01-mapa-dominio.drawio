        <mxCell id="b23" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;CargoAdicional&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Monto : Dinero&lt;br/&gt;+ Estado : PendienteDeAutorizacion | Autorizado&lt;br/&gt;+ AutorizadoPor : CoordinadorId?&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g18" vertex="1">
          <mxGeometry x="496" y="226" width="318" height="97" as="geometry" />
