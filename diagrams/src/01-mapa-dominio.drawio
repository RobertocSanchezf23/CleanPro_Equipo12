        <mxCell id="b5" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Cotizacion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Id : CotizacionId&lt;br/&gt;+ ClienteId : ClienteId&lt;br/&gt;+ Inmueble : DatosDelInmueble&lt;br/&gt;+ Frecuencia : Frecuencia&lt;br/&gt;+ Extras : List&amp;lt;ExtraSolicitado&amp;gt;&lt;br/&gt;+ Estimacion : EstimacionOperativa&lt;br/&gt;+ Precio : Dinero&lt;br/&gt;+ Vigencia : Vigencia&lt;br/&gt;+ Estado : EstadoCotizacion&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Solicitar(...) : Cotizacion «static»&lt;br/&gt;+ Estimar(estimacion, calculadora)&lt;br/&gt;+ Enviar(fechaEnvio)&lt;br/&gt;+ Aceptar(fecha) : EstadoCotizacion&lt;br/&gt;+ Rechazar()&lt;br/&gt;+ MarcarVencida(hoy)&lt;br/&gt;+ EstaAceptada() : bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=3;" parent="g4" vertex="1">
