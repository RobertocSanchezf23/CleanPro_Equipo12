        <mxCell id="b38" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;CalculadoraDePrecio&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;RB-03: $12/m² residencial · $15/m² empresarial&lt;br/&gt;−10% si la frecuencia es recurrente (H-05)&lt;br/&gt;+ cargo de cada extra del catálogo&lt;br/&gt;Tarifas y descuento se inyectan (SOLID S-2)&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Calcular(inmueble, frecuencia, extras) : Dinero&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g37" vertex="1">
          <mxGeometry x="16" y="34" width="330" height="134" as="geometry" />
        </mxCell>
        <mxCell id="b39" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;DisponibilidadDeCuadrilla&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;RES-01: no programar sin cuadrilla disponible&lt;br/&gt;Consulta servicios ya programados&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ EstaDisponibleAsync(cuadrillaId, fechaHora) : bool&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g37" vertex="1">
          <mxGeometry x="362" y="34" width="349" height="105" as="geometry" />
        </mxCell>
        <mxCell id="b40" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Service»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;GeneradorDeFactura&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;Terminado → precio + cargos autorizados&lt;br/&gt;NoRealizado → cargo de cancelación 50%&lt;br/&gt;Una factura por servicio (SUP-04, SOLID S-6)&lt;br/&gt;RB-07, RB-11, RB-14, RES-04&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ GenerarAsync(servicio, fechaEmision) : Factura&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g37" vertex="1">
          <mxGeometry x="727" y="34" width="324" height="134" as="geometry" />
        </mxCell>
        <mxCell id="g41" value="Domain Events (hechos que ya ocurrieron)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="1117" y="797" width="469" height="249" as="geometry" />
        </mxCell>
        <mxCell id="b42" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Domain Event»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Evento  ⟵ lo publica  →  le interesa a&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;CotizacionEnviada  ⟵ Cotizacion  →  Cliente&lt;br/&gt;CotizacionAceptada  ⟵ Cotizacion  →  Coordinador (puede programar)&lt;br/&gt;CotizacionRechazada  ⟵ Cotizacion&lt;br/&gt;CotizacionVencida  ⟵ Cotizacion  →  Coordinador (nueva cotización)&lt;br/&gt;ServicioProgramado  ⟵ Servicio  →  Cliente (US-03)&lt;br/&gt;IncidenciaRegistrada  ⟵ Servicio  →  Administración (RB-06, US-19)&lt;br/&gt;CargoAdicionalAutorizado  ⟵ Servicio&lt;br/&gt;ServicioTerminado  ⟵ Servicio  →  habilita facturación (US-14)&lt;br/&gt;ServicioNoRealizado  ⟵ Servicio  →  cargo de cancelación (RB-11)&lt;br/&gt;FacturaEmitida  ⟵ Factura  →  Cliente (US-05)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g41" vertex="1">
          <mxGeometry x="16" y="34" width="437" height="199" as="geometry" />
        </mxCell>
        <mxCell id="g43" value="Referencias y datos compartidos" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;container=1;collapsible=0;" parent="1" vertex="1">
