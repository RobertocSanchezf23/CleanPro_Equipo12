        <mxCell id="b19" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Servicio&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Id : ServicioId&lt;br/&gt;+ CotizacionId : CotizacionId&lt;br/&gt;+ Programacion : Programacion&lt;br/&gt;+ CuadrillaId : CuadrillaId&lt;br/&gt;+ SupervisorId : SupervisorId&lt;br/&gt;+ PrecioAcordado : Dinero&lt;br/&gt;+ Estado : EstadoServicio&lt;br/&gt;+ Incidencias : List&amp;lt;Incidencia&amp;gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ ProgramarAsync(cotizacion, programacion, cuadrillaId,&lt;br/&gt;      supervisorId, disponibilidad) «static»&lt;br/&gt;+ RegistrarInicio(fechaHora)&lt;br/&gt;+ RegistrarIncidencia(tipo, descripcion, cargo?, supervisorId, fecha)&lt;br/&gt;+ AutorizarCargo(incidenciaId, coordinadorId)&lt;br/&gt;+ RegistrarAccesoDenegado(minutosEspera, supervisorId, fecha)&lt;br/&gt;+ RegistrarTerminacion(fechaHora)&lt;br/&gt;+ VerificarQueEsFacturable()&lt;br/&gt;+ CargosAutorizados() : List&amp;lt;CargoAdicional&amp;gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=3;" parent="g18" vertex="1">
          <mxGeometry x="16" y="34" width="456" height="309" as="geometry" />
        </mxCell>
        <mxCell id="b20" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Programacion&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ FechaHora : DateTime&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g18" vertex="1">
