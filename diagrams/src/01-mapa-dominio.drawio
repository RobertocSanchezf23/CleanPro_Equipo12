        <mxCell id="b30" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Aggregate Root»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Factura&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Id : FacturaId&lt;br/&gt;+ ServicioId : ServicioId&lt;br/&gt;+ Conceptos : List&amp;lt;ConceptoFacturado&amp;gt;&lt;br/&gt;+ Total : Dinero&lt;br/&gt;+ FechaEmision : DateTime&lt;br/&gt;+ EstadoDePago : EstadoDePago&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Emitir(servicioId, conceptos, fecha) : Factura «static»&lt;br/&gt;+ MarcarPagada()&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=3;" parent="g29" vertex="1">
