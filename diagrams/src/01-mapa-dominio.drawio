        <mxCell id="b46" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Value Object compartido»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Dinero&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Monto : decimal&lt;br/&gt;+ Moneda : MXN&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Sumar(otro) : Dinero&lt;br/&gt;+ Restar(otro) : Dinero&lt;br/&gt;+ Porcentaje(p) : Dinero&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g43" vertex="1">
