        <mxCell id="b22" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;&quot;&gt;&lt;i&gt;«Entity»&lt;/i&gt;&lt;br/&gt;&lt;b&gt;Incidencia&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ Id : IncidenciaId&lt;br/&gt;+ Tipo : TipoDeIncidencia&lt;br/&gt;+ Descripcion : string&lt;br/&gt;+ RegistradaEn : DateTime&lt;br/&gt;+ RegistradaPor : SupervisorId&lt;br/&gt;+ Cargo : CargoAdicional?&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;/&gt;&lt;p style=&quot;margin:0px;margin-left:6px;&quot;&gt;+ TieneCargoPendiente() : bool&lt;br/&gt;~ Autorizar(coordinadorId)&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fontSize=11;fillColor=#ffffff;strokeColor=#333333;strokeWidth=1;" parent="g18" vertex="1">
